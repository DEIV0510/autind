---
// Íconos de línea propios (SVG en línea, heredan el color del texto).
interface Props {
  nombre: 'whatsapp' | 'telefono' | 'correo' | 'ubicacion' | 'flecha' | 'flecha-abajo' | 'mas' | 'cerrar' | 'menu' | 'anterior' | 'siguiente' | 'mapa';
  class?: string;
}
const { nombre, class: clase } = Astro.props;
---
{nombre === 'whatsapp' ? (
  <svg class:list={['icono', clase]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23a7.46 7.46 0 0 1-1.38-1.71c-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48a.92.92 0 0 0-.66.31c-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z" />
  </svg>
) : (
  <svg class:list={['icono', clase]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true" focusable="false">
    {nombre === 'telefono' && <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2Z" />}
    {nombre === 'correo' && <><path d="M3 5h18v14H3z" /><path d="m3 6 9 7 9-7" /></>}
    {nombre === 'ubicacion' && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><path d="M12 7v5M9.5 9.5h5" /></>}
    {nombre === 'flecha' && <path d="M4 12h15M13 6l6 6-6 6" />}
    {nombre === 'flecha-abajo' && <path d="M12 4v15M6 13l6 6 6-6" />}
    {nombre === 'mas' && <path d="M12 5v14M5 12h14" />}
    {nombre === 'cerrar' && <path d="m6 6 12 12M18 6 6 18" />}
    {nombre === 'menu' && <path d="M3 7h18M3 12h18M9 17h12" />}
    {nombre === 'anterior' && <path d="M20 12H5M11 6l-6 6 6 6" />}
    {nombre === 'siguiente' && <path d="M4 12h15M13 6l6 6-6 6" />}
    {nombre === 'mapa' && <><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z" /><path d="M9 4v14M15 6v14" /></>}
  </svg>
)}
