---
import Foto from './Foto.astro';
import Icono from './Icono.astro';
import Unifilar from './Unifilar.astro';
import { MENSAJES, SERVICIOS, whatsapp } from '../lib/empresa';
---
<section id="servicios" class="seccion servicios" aria-labelledby="servicios-titulo">
  <div class="contenedor">
    <header class="servicios__cabeza">
      <div>
        <p class="rotulo revelar"><b>02</b> Servicios</p>
        <h2 id="servicios-titulo" class="titular titular--2xl revelar" style="--retardo:0.05s">Soluciones eléctricas para la industria<span class="punto">.</span></h2>
      </div>
      <p class="parrafo revelar" style="--retardo:0.1s">Del componente al tablero terminado: suministro, ensamble e integración para distribución y control eléctrico.</p>
    </header>

    <div class="servicios__grilla">
      {SERVICIOS.map((s, i) => (
        <article class="servicio revelar" id={`servicio-${s.id}`} style={`--retardo:${(i % 2) * 0.08}s`} aria-labelledby={`servicio-${s.id}-titulo`}>
          <div class="servicio__foto">
            <Foto id={s.foto} sizes="(min-width: 1100px) 300px, (min-width: 640px) 46vw, 100vw" />
            <span class="servicio__num" aria-hidden="true">{s.numero}</span>
          </div>
          <div class="servicio__cuerpo">
            <h3 id={`servicio-${s.id}-titulo`} class="titular titular--lg">{s.titulo}</h3>
            <p class="servicio__texto">{s.descripcion}</p>
            <Unifilar tipo={s.id} class="servicio__unifilar" />
            <a class="enlace-flecha servicio__enlace" href={whatsapp(MENSAJES[s.id])} target="_blank" rel="noopener" data-evento="whatsapp" data-origen={`servicio-${s.id}`}>
              <Icono nombre="whatsapp" /><span>Consultar por WhatsApp</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .servicios { background: var(--negro); border-top: 1px solid var(--linea); }
  .servicios__cabeza { display: grid; gap: 1.5rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4rem); }
  .servicios__cabeza .rotulo { margin-bottom: 1.25rem; }
  .servicios__cabeza h2 { max-width: 16ch; }
  @media (min-width: 1024px) { .servicios__cabeza { grid-template-columns: 1.4fr 1fr; gap: 4rem; } }

  .servicios__grilla { display: grid; gap: clamp(1rem, 2vw, 1.5rem); }
  @media (min-width: 640px) { .servicios__grilla { grid-template-columns: repeat(2, 1fr); } }

  .servicio {
    position: relative; display: grid; grid-template-rows: auto 1fr;
    background: var(--grafito); border: 1px solid var(--linea);
    transition: border-color 0.4s var(--curva);
  }
  /* Filo superior amarillo que se extiende al pasar el puntero. */
  .servicio::before {
    content: ''; position: absolute; left: -1px; top: -1px; z-index: 2;
    width: 3rem; height: 3px; background: var(--amarillo);
    transition: width 0.6s var(--curva);
  }
  @media (min-width: 1100px) {
    .servicio { grid-template-rows: none; grid-template-columns: minmax(0, 0.86fr) minmax(0, 1fr); min-height: 26rem; }
  }

  .servicio__foto { position: relative; overflow: hidden; }
  .servicio__foto :global(.foto) { aspect-ratio: 4 / 3; height: 100%; }
  @media (min-width: 1100px) { .servicio__foto :global(.foto) { aspect-ratio: auto; position: absolute; inset: 0; } }
  .servicio__foto :global(img) { transition: transform 1.1s var(--curva); }
  .servicio__num {
    position: absolute; left: 0; bottom: 0; z-index: 1;
    padding: 0.55rem 0.8rem; background: var(--amarillo); color: var(--negro);
    font-family: var(--f-mono); font-size: var(--t-sm); font-weight: 500; letter-spacing: 0.08em;
  }

  .servicio__cuerpo { display: flex; flex-direction: column; gap: 1rem; padding: clamp(1.4rem, 2.4vw, 2rem); }
  .servicio__texto { color: var(--gris); line-height: 1.6; }
  .servicio__unifilar { margin-top: auto; padding-top: 1.25rem; max-width: 18rem; transition: color 0.4s; }
  .servicio__enlace { align-self: flex-start; padding-top: 0.25rem; }
  .servicio__enlace :global(.icono) { color: var(--amarillo); }

  @media (hover: hover) {
    .servicio:hover { border-color: var(--linea-2); }
    .servicio:hover::before { width: calc(100% + 2px); }
    .servicio:hover .servicio__foto :global(img) { transform: scale(1.05); }
    .servicio:hover .servicio__unifilar { color: var(--blanco); }
  }
</style>
