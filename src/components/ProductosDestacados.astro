---
// Portada: hasta 4 productos destacados y las líneas de producto. Sigue la propuesta del cliente
// (tarjetas negras con esquinas en triángulo amarillo, número grande, nombre y resumen).
// Solo se publica cuando hay productos destacados en src/data/productos.json.
import FotoProducto from './FotoProducto.astro';
import Icono from './Icono.astro';
import { DESTACADOS, fotosDe, urlProducto } from '../lib/productos';
import { LINEAS, whatsapp } from '../lib/empresa';
---
{DESTACADOS.length > 0 && (
  <section id="productos" class="seccion destacados" aria-labelledby="destacados-titulo">
    <div class="contenedor">
      <header class="destacados__cabeza">
        <div>
          <p class="rotulo revelar"><b>04</b> Productos</p>
          <h2 id="destacados-titulo" class="titular titular--2xl revelar" style="--retardo:0.05s">Productos destacados<span class="punto">.</span></h2>
        </div>
        <a class="enlace-flecha revelar" href="/productos/"><span>Ver todos los productos</span><Icono nombre="flecha" class="icono--flecha" /></a>
      </header>

      <ul class="destacados__grilla">
        {DESTACADOS.map((p, i) => (
          <li class="destacado revelar" style={`--retardo:${i * 0.06}s`}>
            <a href={urlProducto(p)}>
              <span class="destacado__foto"><FotoProducto foto={fotosDe(p)[0]} alt="" sizes="(min-width: 1024px) 22vw, 45vw" /></span>
              <span class="destacado__num">0{i + 1}</span>
              <span class="destacado__nombre">{p.nombre}</span>
              <span class="destacado__resumen">{p.resumen}</span>
            </a>
          </li>
        ))}
      </ul>

      <ol class="lineas revelar" aria-label="Líneas de producto">
        {LINEAS.map((l) => (
          <li>
            <a href={whatsapp(l.mensaje)} target="_blank" rel="noopener" data-evento="whatsapp" data-origen={`linea-${l.numero}`}>
              <span class="lineas__num">{l.numero}</span>
              <span class="lineas__texto">{l.titulo}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .destacados { background: var(--negro); border-top: 1px solid var(--linea); }
  .destacados__cabeza { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .destacados__cabeza .rotulo { margin-bottom: 1.25rem; }

  .destacados__grilla { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(0.75rem, 1.6vw, 1.25rem); }
  @media (min-width: 1024px) { .destacados__grilla { grid-template-columns: repeat(4, 1fr); } }
  .destacado a {
    position: relative; height: 100%;
    display: grid; justify-items: center; align-content: start; gap: 0.35rem; text-align: center;
    padding: 1.25rem 1rem 1.5rem; border: 1px solid var(--amarillo); background: var(--negro-2);
    transition: background-color 0.35s var(--curva);
  }
  /* Triángulos amarillos en dos esquinas opuestas. */
  .destacado a::before, .destacado a::after { content: ''; position: absolute; width: 1.5rem; height: 1.5rem; background: var(--amarillo); }
  .destacado a::before { top: 0; left: 0; clip-path: polygon(0 0, 100% 0, 0 100%); }
  .destacado a::after { right: 0; bottom: 0; clip-path: polygon(100% 0, 100% 100%, 0 100%); }
  .destacado__foto { width: 100%; max-width: 13rem; overflow: hidden; background: #efefef; margin-bottom: 0.6rem; }
  .destacado__foto :global(.foto) { aspect-ratio: 1 / 1; }
  .destacado__foto :global(img) { transition: transform 0.9s var(--curva); }
  .destacado__num { font-family: var(--f-titular); font-size: clamp(1.5rem, 1.1rem + 1vw, 2rem); color: var(--amarillo); line-height: 1; }
  .destacado__nombre { font-weight: 600; font-size: var(--t-md); line-height: 1.3; }
  .destacado__resumen { color: var(--gris); font-size: var(--t-sm); }
  @media (hover: hover) {
    .destacado a:hover { background: var(--grafito); }
    .destacado a:hover .destacado__foto :global(img) { transform: scale(1.05); }
  }
  @media (max-width: 559px) { .destacado__nombre { font-size: var(--t-sm); } }

  .lineas { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: clamp(1.5rem, 3vw, 2rem); border: 1px solid var(--amarillo); }
  @media (min-width: 1024px) { .lineas { grid-template-columns: repeat(4, 1fr); } }
  .lineas li + li { border-left: 1px solid var(--amarillo); }
  @media (max-width: 1023px) {
    .lineas li:nth-child(3) { border-left: 0; }
    .lineas li:nth-child(n + 3) { border-top: 1px solid var(--amarillo); }
  }
  .lineas a { display: flex; align-items: center; gap: 0.85rem; height: 100%; padding: 1rem clamp(0.85rem, 1.6vw, 1.25rem); transition: background-color 0.35s var(--curva), color 0.35s; }
  .lineas__num { font-family: var(--f-titular); font-size: 1.6rem; color: var(--amarillo); line-height: 1; transition: color 0.35s; }
  .lineas__texto { font-weight: 600; font-size: var(--t-sm); line-height: 1.3; }
  @media (hover: hover) {
    .lineas a:hover { background: var(--amarillo); color: var(--negro); }
    .lineas a:hover .lineas__num { color: var(--negro); }
  }
</style>
