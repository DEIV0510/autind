# Copia este archivo como .env para probar en local. En Vercel, estas mismas variables van en
# Settings → Environment Variables. Ninguna es obligatoria para que el sitio funcione.

# Dominio definitivo (canonical, Open Graph y sitemap). Sin él se usa el dominio de producción
# que entrega Vercel al compilar.
SITE_URL=

# Copia por correo de cada solicitud del formulario (opcional, https://resend.com).
# Sin estas dos variables el formulario funciona igual: la solicitud sale por WhatsApp.
RESEND_API_KEY=
COTIZACION_EMAIL=
# Remitente verificado en Resend, p. ej. «AUTIND Web <web@autind.com.co>»
COTIZACION_REMITENTE=
